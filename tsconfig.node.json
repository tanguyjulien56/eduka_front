{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Node", // Utilisez "Node" pour les modules Node.js
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2020", // Ajoutez la cible ES2020
    "lib": ["ES2020", "DOM"], // Ajoutez les bibliothèques nécessaires
    "esModuleInterop": true, // Pour l'importation des modules CommonJS
    "resolveJsonModule": true // Pour importer des fichiers JSON
  },
  "include": ["vite.config.ts"], // Vous pouvez ajouter d'autres fichiers ou répertoires ici si nécessaire
  "exclude": ["node_modules", "dist"] // Excluez les répertoires que vous ne voulez pas compiler
}
